OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Defaults to anthropic/claude-sonnet-4.5 (good vision + tool-use).
# Other vision-capable picks: google/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-haiku-4.5
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Sent as the HTTP-Referer header for OpenRouter analytics.
# OPENROUTER_HTTP_REFERER=https://treasury-app.vercel.app
