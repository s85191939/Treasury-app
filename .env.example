OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Defaults to google/gemini-2.5-flash -- consistently ~2-3s per
# label in local testing, well under Sarah's 5s budget.
#
# Other vision-capable picks:
#   anthropic/claude-haiku-4.5   ~3-4s, very accurate
#   anthropic/claude-sonnet-4.5  ~5-6s, highest quality (may exceed 5s budget)
#   openai/gpt-4o                varies, strong OCR
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Sent as the HTTP-Referer header for OpenRouter analytics.
# OPENROUTER_HTTP_REFERER=https://treasury-app.vercel.app
